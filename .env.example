# Cantateo Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DJANGO CORE
# =============================================================================

# Secret key - generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Environment selection - set DJANGO_ENV=production on the server
DJANGO_DEBUG=True
DJANGO_ENV=development

# Comma-separated hosts and trusted origins
ALLOWED_HOSTS=cantateo.fr,www.cantateo.fr
CSRF_TRUSTED_ORIGINS=https://cantateo.fr,https://www.cantateo.fr

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

# Option 1: Full DATABASE_URL (recommended)
DATABASE_URL=postgresql://cantateo:password@localhost:5432/cantateo

# Option 2: Individual variables (if DATABASE_URL not set)
# POSTGRES_DB=cantateo
# POSTGRES_USER=cantateo
# POSTGRES_PASSWORD=your-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# =============================================================================
# CACHE (Redis) - Optional but recommended
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CLOUDFLARE R2 (Media Storage)
# =============================================================================

CLOUDFLARE_R2_BUCKET_NAME=psalms-media
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_CUSTOM_DOMAIN=media.cantateo.fr

# =============================================================================
# EMAIL (Optional - for contact form)
# =============================================================================

# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-password
# CONTACT_EMAIL=contact@cantateo.fr
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
SENTRY_DSN=

# =============================================================================
# AUDIO GENERATION (FluidSynth + SoundFont)
# =============================================================================

# Path to the SoundFont file for audio synthesis
SOUNDFONT_PATH=/path/to/soundfonts/UprightPianoKW-20220221.sf2

# Path to FluidSynth executable (optional on Linux if in PATH)
# On Linux: usually /usr/bin/fluidsynth
# On Windows: C:/Program Files/FluidSynth/bin/fluidsynth.exe
FLUIDSYNTH_PATH=/usr/bin/fluidsynth
